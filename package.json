{
  "name": "serial-exit",
  "version": "2.0.0",
  "private": true,
  "description": "Serial Exit — verified off-market deal origination (Next.js, deployable to Firebase Hosting + Cloud Run)",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.2",
    "lenis": "^1.3.26",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "posthog-js": "^1.435.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
