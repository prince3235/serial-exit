# Serial Exit — environment variables
# Copy to .env.local for local development, or configure in Vercel / Cloud Run secrets.

# --- Public site URL (canonical, OG, sitemap, robots, JSON-LD) -------------------
NEXT_PUBLIC_SITE_URL=https://serial-exit.vercel.app

# --- Partner Portal (server-side gate) --------------------------------------------
# Shared access key partners type into the Partner Portal (fails closed if unset).
PORTAL_ACCESS_KEY=

# --- Firestore (Leads, Communications, Automation Logs) ---------------------------
# On Cloud Run: Application Default Credentials work automatically.
# On Vercel / Node servers: supply Firebase Service Account credentials below
# (OR set GOOGLE_SERVICE_ACCOUNT_JSON to the raw or base64-encoded service account JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
IP_HASH_SALT=

# --- Email Automation (Resend — Phase 1 Active) -----------------------------------
RESEND_API_KEY=
# Verified domain sender (leave unset while testing to use Resend sandbox onboarding@resend.dev;
# once custom domain DNS is verified, set e.g. Serial Exit <noreply@serialexit.com>):
CONTACT_FROM_EMAIL=Serial Exit <noreply@serialexit.com>
# Fallback inbox if PARTNER_1_EMAIL is not set:
CONTACT_NOTIFY_EMAIL=teamserialexit@gmail.com

# --- Two Business Partners (Email Alerts) -----------------------------------------
PARTNER_1_NAME=Brijesh Patel
PARTNER_1_EMAIL=
PARTNER_1_WHATSAPP=
PARTNER_2_NAME=Sunil Sen
PARTNER_2_EMAIL=
PARTNER_2_WHATSAPP=

# --- Meta WhatsApp Cloud API ------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Secret from Meta App Dashboard -> App Settings -> Basic (used for X-Hub-Signature-256 verification)
WHATSAPP_APP_SECRET=
# Random secret string entered in Meta Webhook configuration (GET challenge verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Approved Meta WhatsApp Templates (defaults shown; configure to match Meta Business Manager)
WHATSAPP_TEMPLATE_WELCOME=serial_exit_welcome
WHATSAPP_TEMPLATE_PARTNER_ALERT=serial_exit_partner_alert
WHATSAPP_TEMPLATE_LANG=en

# --- Google Sheets Synchronization ------------------------------------------------
# Target spreadsheet ID (from https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
# Share the spreadsheet with the Service Account email (Editor permission).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional dedicated Sheets service account (falls back to FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY):
# GOOGLE_SHEETS_CLIENT_EMAIL=
# GOOGLE_SHEETS_PRIVATE_KEY=

# --- Automation Retry Scheduler ---------------------------------------------------
# Bearer token checked by POST /api/automation/retry (for Vercel Cron / external jobs)
CRON_SECRET=

# --- Analytics & 3D (optional, build-time) ----------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_DISABLE_3D=0
