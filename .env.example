# Serial Exit — environment variables
# Copy to .env.local for local development. On Cloud Run these are set by scripts/deploy.sh.
# EVERYTHING here is optional — the site renders without any of it.

# --- Public site URL (canonical, OG, sitemap, robots, JSON-LD) -------------------
# BUILD-TIME: inlined into the bundle. Set to your final production URL before building.
NEXT_PUBLIC_SITE_URL=https://serialexit.com

# --- Partner Portal (server-side gate) --------------------------------------------
# Shared access key partners type into the portal. If unset, the portal cannot be
# unlocked at all (fails closed). Use a long random string; on Cloud Run keep it in
# Secret Manager as `portal-access-key`. Rotating it signs everyone out.
PORTAL_ACCESS_KEY=

# --- Contact form storage: Firestore ------------------------------------------------
# On Cloud Run: nothing to set (uses the service account). Locally, either run the
# emulator:   firebase emulators:start --only firestore   and set
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# or `gcloud auth application-default login`.
# FIRESTORE_DATABASE_ID=(default)
# Optional salt for hashing client IPs stored with enquiries:
IP_HASH_SALT=

# --- Contact form email forwarding (Resend) ----------------------------------------
# If set, each enquiry is also emailed. The form succeeds if EITHER Firestore or email works.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=partners@serialexit.com
CONTACT_FROM_EMAIL=Serial Exit <onboarding@resend.dev>

# --- Analytics (PostHog, cookieless) ----------------------------------------------
# BUILD-TIME. If unset, no analytics code is loaded.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Search Console verification token (BUILD-TIME) --------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- 3D hero layer -----------------------------------------------------------------
# Set to "1" to disable the WebGL layer entirely (BUILD-TIME).
NEXT_PUBLIC_DISABLE_3D=0
